PORT=3001
APP_PASSWORD=password123
SESSION_SECRET=replace-with-at-least-32-random-characters
UPDATER_TOKEN=replace-with-a-separate-long-random-secret
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
NODE_ENV=development
# Set true only behind HTTPS in production
COOKIE_SECURE=false
# HTTPS JSON manifest from your vetted disclosure ingestion pipeline (optional)
DISCLOSURE_MANIFEST_URL=

# Neon: paste the pooled connection string from the project's Connect dialog.
# Example: postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# When set, portfolios, import history and sessions use Postgres. Blank uses DATA_DIR locally.
DATABASE_URL=
